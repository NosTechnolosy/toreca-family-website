{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "トレカfamily サイト更新",
  "version": "0.1.0",
  "identifier": "jp.toreca-family.site-updater",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "トレカfamily サイト更新",
        "width": 1120,
        "height": 820,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https://* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
